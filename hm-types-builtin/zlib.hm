// ==========================================================================

gzipSync :: Buffer | String -> Buffer
gunzipSync :: Buffer -> Buffer
deflateSync :: Buffer | String -> Buffer
inflateSync :: Buffer -> Buffer
brotliCompressSync :: Buffer | String -> Buffer
brotliDecompressSync :: Buffer -> Buffer
